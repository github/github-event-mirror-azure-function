{
  "name": "webhook-mirror",
  "version": "1.0.0",
  "description": "Mirror GitHub events back to the originating repository",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "jest"
  },
  "dependencies": {
    "@azure/functions": "^4.11.0",
    "@probot/adapter-azure-functions": "github:probot/adapter-azure-functions#4a0f805a7916c07e6dd9d7f1c29e1e75ea72d190",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^18.x",
    "@typescript-eslint/parser": "^6.18.1",
    "browserslist": "^4.28.7",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.3.1",
    "nock": "^13.3.8",
    "prettier": "3.1.1",
    "probot": "^14.3.2",
    "rimraf": "^5.0.0",
    "smee-client": "^2.0.1",
    "ts-jest": "^29.1.1",
    "typescript": "^4.0.0"
  },
  "main": "dist/src/functions/azureprobot.js",
  "overrides": {
    "glob@>=10.0.0": {
      "minimatch": "9.0.7",
      "brace-expansion@^1.1.7": "1.1.18"
    },
    "@babel/core": "7.29.6",
    "@opentelemetry/core": "2.8.0"
  }
}
